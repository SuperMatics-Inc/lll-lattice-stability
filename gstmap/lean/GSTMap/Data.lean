/-- the 76 root quadtrees, index `19*k + j` for column `k<4`, row `j<19`. -/
def forestList : List QT := [tr0, tr1, tr2, tr3, tr4, tr5, tr6, tr7, tr8, tr9, tr10, tr11, tr12, tr13, tr14, tr15, tr16, tr17, tr18, tr19, tr20, tr21, tr22, tr23, tr24, tr25, tr26, tr27, tr28, tr29, tr30, tr31, tr32, tr33, tr34, tr35, tr36, tr37, tr38, tr39, tr40, tr41, tr42, tr43, tr44, tr45, tr46, tr47, tr48, tr49, tr50, tr51, tr52, tr53, tr54, tr55, tr56, tr57, tr58, tr59, tr60, tr61, tr62, tr63, tr64, tr65, tr66, tr67, tr68, tr69, tr70, tr71, tr72, tr73, tr74, tr75]
def forest (k j : ℕ) : QT := forestList.getD (19 * k + j) (.leaf .undec)

theorem forest_skip_ok : ∀ k : Fin 4, ∀ j : Fin 19,
    (forest k j).skipOK (rootCell k j) = true := by decide +kernel
theorem skip_ok : ∀ kc ∈ allLeaves forest, kc.1 = Kind.skip →
    (kc.2.x + kc.2.h) ^ 2 + (kc.2.y + kc.2.h) ^ 2 < 1 := by
  intro kc hk hks
  simp only [allLeaves, List.mem_flatMap, List.mem_range] at hk
  obtain ⟨k,hk,j,hj,hkc⟩ := hk
  exact (forest k j).skipOK_correct _ (forest_skip_ok ⟨k,hk⟩ ⟨j,hj⟩) kc hkc hks
theorem structural_count_skip : forestCount forest Kind.skip = 66 := by decide +kernel
theorem count_skip : ((allLeaves forest).filter (fun kc => kc.1 == Kind.skip)).length = 66 := by
  rw [allLeaves_count, structural_count_skip]
theorem structural_count_stab : forestCount forest Kind.stab = 4178 := by decide +kernel
theorem count_stab : ((allLeaves forest).filter (fun kc => kc.1 == Kind.stab)).length = 4178 := by
  rw [allLeaves_count, structural_count_stab]
theorem structural_count_unst : forestCount forest Kind.unst = 25088 := by decide +kernel
theorem count_unst : ((allLeaves forest).filter (fun kc => kc.1 == Kind.unst)).length = 25088 := by
  rw [allLeaves_count, structural_count_unst]
theorem structural_count_undec : forestCount forest Kind.undec = 11238 := by decide +kernel
theorem count_undec : ((allLeaves forest).filter (fun kc => kc.1 == Kind.undec)).length = 11238 := by
  rw [allLeaves_count, structural_count_undec]
theorem count_all : (allLeaves forest).length = 40570 := by
  have hs := count_skip; have ht := count_stab; have hu := count_unst; have hx := count_undec
  have hh : ∀ l : List (Kind × RCell), l.length =
      (l.filter (fun kc => kc.1 == Kind.skip)).length +
      (l.filter (fun kc => kc.1 == Kind.stab)).length +
      (l.filter (fun kc => kc.1 == Kind.unst)).length +
      (l.filter (fun kc => kc.1 == Kind.undec)).length := by
    intro l; induction l with
    | nil => simp
    | cons a l ih =>
      rcases a with ⟨k,c⟩
      cases k <;> simp_all <;> omega
  have := hh (allLeaves forest)
  omega

